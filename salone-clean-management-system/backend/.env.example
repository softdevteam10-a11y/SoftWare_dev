# ---------------------------------------------------------------------------
# Management Subsystem — environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# HTTP port this subsystem listens on
PORT=4002

# --- Database (owned exclusively by this subsystem) ------------------------
# On Render with Neon: set DATABASE_URL to Neon's connection string
# (Neon dashboard → Connection Details → "Connection string"). SSL is
# enabled automatically whenever DATABASE_URL is set — do not also set
# PGHOST/etc.
# DATABASE_URL=postgres://user:password@ep-example.neon.tech/dbname?sslmode=require
#
# For local development, use the discrete vars below instead:
PGHOST=localhost
PGPORT=5432
PGDATABASE=salone_clean_management
PGUSER=postgres
PGPASSWORD=change_me
# PGSSL=false

# --- API Gateway ------------------------------------------------------------
# This is the ONLY door through which this subsystem reaches the Customer
# Subsystem or Driver Subsystem — e.g. to broadcast a global route update,
# or to pull aggregate stats. It never queries their databases directly.
#
# For LOCAL TESTING, point this at the mock gateway included in this
# project bundle (salone-clean-mock-gateway) so route deploys succeed and
# the "Total Tokens Redeemed" KPI becomes a real (not simulated) number:
API_GATEWAY_BASE_URL=http://localhost:4003/api/v1
# In production, swap this for the real Gateway's URL, e.g.:
# API_GATEWAY_BASE_URL=https://gateway.saloneclean.sl/api/v1
API_GATEWAY_SERVICE_KEY=local-test-key

# Allowed origin(s) for the admin dashboard frontend.
# Use "*" for quick local testing (e.g. opening index.html directly from disk).
# On Render, this MUST be set — there is no default that works for a
# deployed frontend. Set it to your deployed frontend's exact origin (no
# trailing slash, no path), e.g. https://salone-clean-management-frontend.onrender.com
CORS_ORIGIN=*
