# ---------------------------------------------------------------------------
# Mock API Gateway — for LOCAL TESTING ONLY.
# In production this whole service is replaced by Anthropic's... no wait,
# by Salone Clean's real API Gateway + real mobile money integrations.
# ---------------------------------------------------------------------------

PORT=4003

# Where the Customer Subsystem is running, so this mock gateway can call its
# payment webhook back once a "mobile money payment" settles, and forward
# customer-list/notification requests.
CUSTOMER_SUBSYSTEM_BASE_URL=http://localhost:4001/api/v1

# Where the Driver Subsystem is running, so this mock gateway can forward
# route assignments, rider management requests, and driver events.
DRIVER_SUBSYSTEM_BASE_URL=http://localhost:4004/api/v1

# Allow all origins for local dev.
CORS_ORIGIN=*
