# ---------------------------------------------------------------------------
# Customer Subsystem — environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# HTTP port this subsystem listens on
PORT=4001

# --- Local Customer Database (owned exclusively by this subsystem) --------
PGHOST=localhost
PGPORT=5432
PGDATABASE=salone_clean_customers
PGUSER=customer_service
PGPASSWORD=change_me

# --- API Gateway ------------------------------------------------------------
# This is the ONLY door through which this subsystem talks to the Driver
# Subsystem, the Management Subsystem, or external payment rails. It never
# calls their databases or internal services directly.
#
# For LOCAL TESTING, point this at the mock gateway included in this
# project bundle (salone-clean-mock-gateway) so payments actually settle:
API_GATEWAY_BASE_URL=http://localhost:4003/api/v1
# In production, swap this for the real Gateway's URL, e.g.:
# API_GATEWAY_BASE_URL=https://gateway.saloneclean.sl/api/v1
API_GATEWAY_SERVICE_KEY=local-test-key

# Allowed origin(s) for the mobile-responsive frontend during development
CORS_ORIGIN=http://localhost:5173
