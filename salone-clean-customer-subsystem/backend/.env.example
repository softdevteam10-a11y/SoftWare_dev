# ---------------------------------------------------------------------------
# Customer Subsystem — environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# HTTP port this subsystem listens on
PORT=4001

# --- Database (owned exclusively by this subsystem) ------------------------
# On Render with Neon: set DATABASE_URL to Neon's connection string
# (Neon dashboard → Connection Details → "Connection string", the one that
# starts with postgres:// and ends with ?sslmode=require). SSL is enabled
# automatically whenever DATABASE_URL is set — do not also set PGHOST/etc.
# DATABASE_URL=postgres://user:password@ep-example.neon.tech/dbname?sslmode=require
#
# For local development, use the discrete vars below instead:
PGHOST=localhost
PGPORT=5432
PGDATABASE=salone_clean_customers
PGUSER=customer_service
PGPASSWORD=change_me
# Set PGSSL=true if your local/managed Postgres also requires SSL.
# PGSSL=false

# --- API Gateway ------------------------------------------------------------
# This is the ONLY door through which this subsystem talks to the Driver
# Subsystem, the Management Subsystem, or external payment rails. It never
# calls their databases or internal services directly.
#
# For LOCAL TESTING, point this at the mock gateway included in this
# project bundle (salone-clean-mock-gateway) so payments actually settle:
API_GATEWAY_BASE_URL=http://localhost:4003/api/v1
# In production, swap this for the real Gateway's URL, e.g.:
# API_GATEWAY_BASE_URL=https://gateway.saloneclean.sl/api/v1
API_GATEWAY_SERVICE_KEY=local-test-key

# Allowed origin(s) for the frontend. Use "*" for local testing (e.g.
# opening index.html directly from disk). On Render, set this to your
# deployed frontend's exact origin (no trailing slash, no path) — e.g.
# https://salone-clean-customer-frontend.onrender.com — or requests will
# be silently blocked by the browser with a CORS error.
CORS_ORIGIN=*
